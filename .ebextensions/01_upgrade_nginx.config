# Upgrade system nginx to 1.30.6 when needed (same logic/corrections as the SSH updater):
# - AL2023 nginx.org repo URLs (amzn/2023)
# - Prefer amazonlinux nginx-core when TARGET exists there
# - --allowerasing / remove nginx-core before nginx.org package
# - Backup/restore site config; drop conf.d/default.conf welcome page
# - stable → mainline → direct RPM fallback
#
# Runs on every instance (not leader_only). Skips package install if already on 1.30.6*.
# Platform usually restarts the proxy later in the deploy; pass "restart" if you need it here.

container_commands:
  01_upgrade_nginx_1_30_6:
    command: "bash .ebextensions/upgrade-nginx.sh 1.30.6 norestart"
    leader_only: false
